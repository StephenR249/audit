# Copy to .env and fill in. .env is gitignored — never commit real keys.

# Required: your Anthropic API key (server-side only).
ANTHROPIC_API_KEY=sk-ant-...

# Model + generation tuning.
PITCHGYM_MODEL=claude-opus-5
PITCHGYM_MAX_TOKENS=1024
PITCHGYM_EFFORT=low

# Abuse / cost protection (per client IP).
RATE_LIMIT_PER_MIN=20
MONTHLY_TOKEN_BUDGET_PER_IP=200000

# CORS: set to your frontend origin in production (e.g. https://pitchgym.io).
# Leave blank for local dev.
CORS_ORIGIN=

# Server.
PORT=3000
# Set to false when the frontend is hosted separately (Netlify/Cloudflare Pages).
SERVE_STATIC=true
