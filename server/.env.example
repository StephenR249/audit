# Copy to .env and fill in. .env is gitignored — never commit real keys.

# Required: your Anthropic API key (server-side only).
ANTHROPIC_API_KEY=sk-ant-...

# Model + generation tuning.
PITCHGYM_MODEL=claude-opus-5
PITCHGYM_MAX_TOKENS=1024
PITCHGYM_EFFORT=low

# Abuse / cost protection (per account when signed in, else per IP).
RATE_LIMIT_PER_MIN=20
MONTHLY_TOKEN_BUDGET_PER_IP=200000

# Auth. Set AUTH_SECRET to a long random string in production (e.g.
# `openssl rand -hex 32`) so session tokens survive restarts and can't be forged.
AUTH_SECRET=
SESSION_TTL_DAYS=30
# Optional: require this code to mint a session (locks down who can use the API).
# Leave blank for open anonymous-device signup during development.
SIGNUP_CODE=

# CORS: set to your frontend origin in production (e.g. https://pitchgym.io).
# Leave blank for local dev.
CORS_ORIGIN=

# Server.
PORT=3000
# Set to false when the frontend is hosted separately (Netlify/Cloudflare Pages).
SERVE_STATIC=true
